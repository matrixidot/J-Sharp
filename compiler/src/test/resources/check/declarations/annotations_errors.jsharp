    @Deprecated(since = Misused.version())                //~ JS0430
    public void notConstant() { }

    @Deprecated @Deprecated                               //~ JS0431
    public void twice() { }

    @get:Deprecated                                       //~ JS0431
    public void targetOnAMethod() { }

    public static String version() => "1";
}

@java.lang.annotation.Retention                           //~ JS0430 JS0431
public class MissingValue { }
