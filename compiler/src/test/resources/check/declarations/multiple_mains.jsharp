// A program has one entry point; two main methods are an error, not an arbitrary choice.
public class App {
    public static void main(String[] args) { }
}
public class Other {
    public static void main(String[] args) { }            //~ JS0411
}
public class NotAnEntry {
    public static int main(int x) => x;                   // a different signature is fine
    public void main(String[] args) { }                   // so is an instance method
}
