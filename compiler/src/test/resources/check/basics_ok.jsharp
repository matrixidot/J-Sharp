import java.util.*;

int square(int x) => x * x;
long widen(int x) => x;
double mix(int a, long b, float c) => a + b + c;
String greet(String name) => "Hello, " + name + "!";
boolean even(int n) => n % 2 == 0;
char next(char c) => (char) (c + 1);
byte small() { byte b = 10; b += 5; return b; }

