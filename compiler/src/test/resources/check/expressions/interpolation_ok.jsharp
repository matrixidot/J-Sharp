// Interpolated strings with .NET-style and raw Java format specifiers (FormatSpecs).
String name = "Ann";
int age = 30;
long big = 123456789L;
double score = 97.456;
float ratio = 0.25f;
Integer boxed = 5;
byte small = 7;
char letter = 'z';

String plain = $"Hello {name}, you are {age}";
String expr = $"Next year: {age + 1}";
String call = $"{name.toUpperCase()} has {name.length()} letters";
String cond = $"{(age > 18 ? "adult" : "minor")}";
String nested = $"outer {$"inner {age}"} done";
String fixed = $"Score {score:F2}";
String fixedDefault = $"{score:F}";
String fixedFloat = $"{ratio:F1}";
String grouped = $"{1234567.891:N2}";
String exponent = $"{score:E3}";
String exponentLower = $"{score:e}";
String percent = $"{ratio:P1}";
String padded = $"{age:D5}";
String paddedLong = $"{big:D12}";
String paddedBoxed = $"{boxed:D2}";
String paddedByte = $"{small:D3}";
String hex = $"{255:X}";
String hexLower = $"{255:x4}";
String hexLong = $"{big:X16}";
String general = $"{name:G}";
String generalNumber = $"{score:G}";
String javaSpec = $"{score:%08.3f}";
String javaString = $"{name:%-10s}";
String charHole = $"[{letter}]";
String raw = $"""total={age * 2}, name={name}""";
String noHoles = $"just text";
String empty = $"";
println(plain + expr + call + cond + nested + fixed + fixedDefault + fixedFloat + grouped);
println(exponent + exponentLower + percent + padded + paddedLong + paddedBoxed + paddedByte);
println(hex + hexLower + hexLong + general + generalNumber + javaSpec + javaString + charHole);
println(raw + noHoles + empty);
