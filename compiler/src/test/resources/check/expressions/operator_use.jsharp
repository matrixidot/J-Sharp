// Using user-defined operators; built-in meanings are unchanged (D077).
public record Point(int x, int y) {
    public static Point operator +(Point a, Point b) => new Point(a.x + b.x, a.y + b.y);
    public static Point operator *(Point a, int k) => new Point(a.x * k, a.y * k);
    public static boolean operator <=(Point a, Point b) => a.x <= b.x;   //~ JS0410
}
var p = new Point(1, 2) + new Point(3, 4);
var scaled = p * 3;
var twice = 3 * p;                                                      //~ JS0600
var q = new Point(1, 2) - new Point(1, 1);                              //~ JS0607
var s = "x" + new Point(1, 1);                                          // concatenation is unchanged
var acc = new Point(0, 0);
acc += p;
acc *= 2;
String text = "a";
text += new Point(0, 0);                                                // still string concatenation
Point bad = new Point(0, 0);
bad += 5;                                                               //~ JS0600
