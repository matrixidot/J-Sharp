---
class Box<T : Comparable<T> & Serializable> : Object [public final]
  field value: T [private backing]
  property value: T get=getValue set=setValue backed [public]
  method getValue(): T [public getter]
  method setValue(T value): void [public setter]
  method <init>(): void [public generated]
class Node<T : Object> : Object [public final]
  field value: T [public]
  field next: Node<T>? [public]
  field children: Map<T, List<Node<T>>> [public]
  method <init>(): void [public generated]
interface Pair<out A : Object, out B : Object> [public abstract interface]
  method first(): A [public abstract]
  method second(): B [public abstract]
interface Sink<in T : Object> [public abstract interface]
  method accept(T value): void [public abstract]
interface Source<out T : Object> [public abstract interface]
  method next(): T [public abstract]
class Util : Object [public final]
  method <T> max(T a, T b): T [public static]
  method <T, R> map(List<T> xs, Function<T, R> f): List<R> [public static]
  method <T> sortAll(List<T> xs): void [public static]
  method <init>(): void [public generated]
