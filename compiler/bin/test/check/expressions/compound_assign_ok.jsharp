// Compound assignments include an implicit narrowing cast back to the target type (Java rule).
int i = 10;
i += 5;
i -= 2;
i *= 3;
i /= 2;
i %= 7;
i &= 0xF;
i |= 0x10;
i ^= 1;
i <<= 2;
i >>= 1;
i >>>= 1;
long l = 1;
l <<= 40;
l += i;
l |= 1L << 50;
byte b = 10;
b += 5;
b *= 2;
b <<= 1;
b -= i;
short sh = 1;
sh -= 300;
char c = 'a';
c += 2;
double d = 1.0;
d += 1;
d /= 3;
d *= i;
float f = 1f;
f += 2;
String s = "a";
s += "b";
s += 1;
s += 'c';
s += 2.5;
s += true;
boolean flag = true;
flag &= false;
flag |= true;
flag ^= true;
Integer boxed = 1;
boxed += 1;
boxed *= 3;
int[] arr = new int[3];
arr[0] += 5;
arr[1] <<= 2;
var x = 0;
var y = (x += 3);
int checkY = y;
int chained = 0;
int other = 0;
chained = other = 7;
println(i + l + b + sh + c + d + f + s + flag + boxed + arr[0] + chained);
