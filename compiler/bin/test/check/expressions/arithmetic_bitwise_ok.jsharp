// Arithmetic, bitwise and shift operators on primitives; result types checked via assignment.
int a = 17;
int b = 5;
int sum = a + b;
int diff = a - b;
int prod = a * b;
int quot = a / b;
int rem = a % b;
int negRem = -a % b;
int precedence = 2 + 3 * 4 - 6 / 2;
int grouped = (2 + 3) * 4;
long scaled = a * 1_000_000_000L;
double ratio = a / (double) b;
double fmod = 7.5 % 2.0;
int wraps = Integer.MAX_VALUE + 1;
int divByZeroAtRuntime = a / (b - 5);

int and = a & b;
int or = a | b;
int xor = a ^ b;
int not = ~a;
long longMask = 0xFFL & a;
int shl = a << 2;
int shr = a >> 1;
int ushr = -a >>> 28;
long longShift = 1L << 63;
long longByLong = 1L << 2L;
int intByLong = 1 << 2L;
byte small = 1;
int byteShift = small << 3;
char ch = 'A';
int charShift = ch >> 1;
int charMask = ch & 0x1F;

boolean bitAnd = true & false;
boolean bitOr = true | false;
boolean bitXor = true ^ true;
boolean lt = a < b;
boolean le = a <= b;
boolean gt = a > b;
boolean ge = a >= b;
boolean mixedCompare = a < 2.5;
boolean charCompare = ch < 'Z';
boolean longCompare = scaled > a;
double nan = 0.0 / 0.0;
boolean nanCheck = nan != nan;
boolean nanEquals = Double.NaN == Double.NaN;
Integer boxedA = 3;
Long boxedB = 4L;
long boxedArithmetic = boxedA + boxedB;
boolean boxedCompare = boxedA < boxedB;
int boxedShift = boxedA << 1;
