var stringIntNot = s != i;               //~ JS0607
var boolInt = t == 1;                    //~ JS0607
var stringBuilder = s == new StringBuilder();  //~ JS0607
var records = new Meters(1) == new Feet(1);    //~ JS0607
var identityStringInt = s === 1;         //~ JS0607
var identityRecords = new Meters(1) !== new Feet(1);  //~ JS0607
Shape shape = getShape();
var finalVsInterface = new Label() == shape;   //~ JS0607
var boolString = t != s;                 //~ JS0607
