public val PI = 3.14159;
public static final String APP = "demo";
public var hits = 0;
private final int LIMIT = 10;

public double circleArea(double r) => PI * r * r;
public static int clamp(int x) => Math.min(x, LIMIT);
private helper(int x) => x + 1;

public class Geometry {
    public double unit() => circleArea(1.0);
    public void record() { hits++; }
    public int limited(int x) => clamp(helper(x));
}

var g = new Geometry();
g.record();
println(g.unit() + hits);
println(APP + g.limited(50));
var local = helper(1);
PI = 3.0;                                            //~ JS0609
APP = "x";                                           //~ JS0609
hits = "many";                                       //~ JS0600
println(circleArea("r"));                            //~ JS0600
