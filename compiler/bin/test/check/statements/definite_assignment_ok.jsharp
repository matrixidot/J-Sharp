import java.util.*;

int bothBranches(boolean c) {
    int x;
    if (c) {
        x = 1;
    } else {
        x = 2;
    }
    return x;
}

int thenReturns(boolean c) {
    int x;
    if (c) {
        return 0;
    } else {
        x = 5;
    }
    return x;
}

int elseThrows(boolean c) {
    int x;
    if (c) {
        x = 1;
    } else {
        throw new IllegalStateException("no");
    }
    return x;
}

int whileTrue() {
    int x;
    while (true) {
        x = 3;
        break;
    }
    return x;
}

int doWhileBody() {
    int x;
    do {
        x = 7;
    } while (x < 3);
    return x;
}

String allSwitchSections(int k) {
    String s;
    switch (k) {
        case 1:
            s = "one";
            break;
        case 2:
            s = "two";
            break;
        default:
            s = "many";
            break;
    }
    return s;
}

String switchExpressionInit(int k) {
    String s = k switch {
        1 => "one",
        _ => "other",
    };
    return s;
}

int tryAssignsOrCatchReturns() {
    int x;
    try {
        x = Integer.parseInt("12");
    } catch (NumberFormatException e) {
        return -1;
    }
    return x;
}

int tryAndCatchBothAssign() {
    int x;
    try {
        x = Integer.parseInt("12");
    } catch (NumberFormatException e) {
        x = 0;
    }
    return x;
}

int assignedInFinally() {
    int x;
    try {
        println("work");
    } finally {
        x = 9;
    }
    return x;
}

int shortCircuit(Object o) {
    int n;
    if (o is String s && (n = s.length()) > 0) {
        return n;
    }
    return 0;
}

int ternaryBoth(boolean c) {
    int x;
    int y = c ? (x = 1) : (x = 2);
    return x + y;
}

int forInit() {
    int x;
    for (x = 0; x < 10; x++) { }
    return x;
}

int labeledBlock(boolean c) {
    int r;
    if (c) {
        r = 1;
    } else if (!c) {
        r = 2;
    } else {
        r = 3;
    }
    return r;
}

println(bothBranches(true) + thenReturns(false) + elseThrows(true) + whileTrue() + doWhileBody());
