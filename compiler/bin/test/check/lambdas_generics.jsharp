import java.util.*;
import java.util.function.*;
import java.util.stream.*;

Function<int, int> inc = x => x + 1;
BiFunction<int, int, int> add = (a, b) => a + b;
Supplier<String> sup = () => "hi";
Runnable run = () => println("run");
Predicate<String> empty = String::isEmpty;
Function<String, Integer> len = String::length;
Supplier<List<String>> mk = ArrayList::new;
Consumer<Object> printer = System.out::println;
println(inc.apply(1));
println(add.apply(2, 3));
var names = List.of("bob", "alice", "eve");
var upper = names.stream().map(n => n.toUpperCase()).collect(Collectors.toList());
var lengths = names.stream().map(String::length).toList();
var total = names.stream().mapToInt(String::length).sum();
var sorted = new ArrayList<String>(names);
sorted.sort(Comparator.comparing(String::length));
sorted.sort((x, y) => x.compareTo(y));
names.forEach(n => println(n));
var filtered = names.stream().filter(n => n.length() > 3).count();
Optional<String> firstLong = names.stream().filter(n => n.length() > 4).findFirst();
println(firstLong.orElse("none"));
var map = new HashMap<String, Integer>();
map.merge("a", 1, Integer::sum);
map.computeIfAbsent("b", k => 2);
