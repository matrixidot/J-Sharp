// == is null-safe equals on references, === is identity; primitives compare numerically.
import java.util.*;

public record P(int x, int y);
public enum Color { Red, Green }

Integer a = 1000;
Integer b = 1000;
println(a == b);
println(a === b);
Integer c = 100;
Integer d = 100;
println(c === d);
int? na = null;
int? nb = null;
println(na == nb);
println(na == a);
println(a != na);
var p1 = new P(1, 2);
var p2 = new P(1, 2);
println(p1 == p2);
println(p1 === p2);
println(p1 != p2);
println(p1 !== p2);
println(p1 == new P(2, 1));
var arr1 = new int[] { 1, 2 };
var arr2 = new int[] { 1, 2 };
println(arr1 == arr2);
println(Arrays.equals(arr1, arr2));
var arr3 = arr1;
println(arr1 == arr3);
Color col = Color.Red;
println(col == Color.Red);
println(col != Color.Green);
Object o1 = "str";
Object o2 = new String("str");
println(o1 == o2);
println(o1 === o2);
String? sn = null;
println(sn == null);
println(null == sn);
var list1 = List.of(1, 2);
var list2 = new ArrayList<Integer>(list1);
println(list1 == list2);
println(list1 === list2);
long bigl = 5;
int smalli = 5;
println(bigl == smalli);
double five = 5.0;
println(smalli == five);
char ch = 'a';
int code = 97;
println(ch == code);
Object boxedInt = 5;
Object boxedLong = 5L;
println(boxedInt == boxedLong);
Object same = p1;
println(same === p1);
println(same == p1);
