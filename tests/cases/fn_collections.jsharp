import java.util.*;

var list = new ArrayList<int>(List.of(5, 12, 7, 3, 20, 8));
list.removeIf(x => x % 2 == 1);
println(list);
list.replaceAll(x => x / 4);
println(list);
list.add(0, 9);
println(list);
list.remove(Integer.valueOf(5));
println(list);
list.remove(0);
println(list);
Collections.addAll(list, 4, 1, 6);
Collections.sort(list);
println(list);
println(Collections.binarySearch(list, 4));
Collections.reverse(list);
println(list);
println(list.subList(1, 3));
println(list.indexOf(3) + " " + list.contains(7));

var inventory = new HashMap<String, int>();
inventory.put("apple", 5);
inventory.merge("apple", 3, Integer::sum);
inventory.merge("pear", 2, Integer::sum);
inventory.compute("apple", (k, v) => v == null ? 1 : v * 10);
inventory.computeIfAbsent("plum", k => k.length());
inventory.computeIfPresent("pear", (k, v) => v + 100);
inventory.putIfAbsent("pear", 0);
println(new TreeMap<String, int>(inventory));
println(inventory.getOrDefault("fig", -1));
var sorted = new TreeMap<String, int>(inventory);
println(sorted.firstKey() + " " + sorted.lastEntry().getValue());
println(sorted.headMap("pear"));
println(sorted.descendingMap());
inventory.entrySet().removeIf(e => e.getValue() > 50);
println(new TreeMap<String, int>(inventory));

var names = new LinkedList<String>(List.of("ann", "bob", "cat", "dan"));
var it = names.iterator();
while (it.hasNext()) {
    if (it.next().startsWith("b")) it.remove();
}
println(names);
var ordered = new LinkedHashMap<String, int>();
ordered.put("z", 1);
ordered.put("a", 2);
println(ordered);
println(Collections.frequency(List.of(1, 2, 1, 1), 1));
println(Collections.nCopies(3, "ab"));
var frozen = List.copyOf(names);
try {
    frozen.add("x");
} catch (UnsupportedOperationException e) {
    println("immutable");
}
var set = new TreeSet<String>(List.of("pear", "fig", "apple"));
println(set.first() + " " + set.ceiling("b") + " " + set.headSet("g"));
