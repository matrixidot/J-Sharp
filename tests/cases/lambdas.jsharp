import java.util.*;
import java.util.function.*;

Function<int, int> square = x => x * x;
BiFunction<int, int, int> add = (a, b) => a + b;
Supplier<String> hello = () => "hello";
Predicate<String> isEmpty = String::isEmpty;
Function<String, int> len = String::length;
UnaryOperator<String> upper = s => s.toUpperCase();
Runnable r = () => println("running");
println(square.apply(7));
println(add.apply(2, 3));
println(hello.get());
println(isEmpty.test(""));
println(len.apply("four"));
println(upper.andThen(s => s + "!").apply("hey"));
r.run();
var factor = 3;
Function<int, int> times = x => x * factor;
println(times.apply(5));
IntBinaryOperator mul = (a, b) => a * b;
println(mul.applyAsInt(6, 7));
var names = new ArrayList<String>(List.of("charlie", "alice", "bob"));
names.sort(Comparator.comparing(String::length));
println(names);
names.sort((a, b) => b.compareTo(a));
println(names);
names.forEach(n => print(n.charAt(0)));
println();
Supplier<List<String>> mk = ArrayList::new;
var fresh = mk.get();
fresh.add("x");
println(fresh);
Function<int, int[]> arr = int[]::new;
println(arr.apply(4).length);
Consumer<Object> out = System.out::println;
out.accept("via method ref");
Function<int, Function<int, int>> adder = a => b => a + b;
println(adder.apply(10).apply(5));
class Box { int v; Box(int v) { this.v = v; } int get() => v; }
var boxes = List.of(new Box(3), new Box(1));
println(boxes.stream().mapToInt(Box::get).sum());
