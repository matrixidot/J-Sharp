// IEEE 754 comparisons, NaN, signed zero, and boxed equality.
double nan = Double.NaN;
println(nan == nan);
println(nan != nan);
println(nan < 1.0);
println(nan > 1.0);
println(nan <= nan);
println(!(nan >= 0));
println(Double.isNaN(nan));
println(Double.compare(nan, nan));
println(Double.compare(0.0, -0.0));
println(0.0 == -0.0);
println(1.0 / -0.0);
println(Math.min(0.0, -0.0));
println(nan + 1);
println(Double.POSITIVE_INFINITY - Double.POSITIVE_INFINITY);
println(Double.POSITIVE_INFINITY > Double.MAX_VALUE);
float fn = Float.NaN;
println(fn == fn);
println((double) fn == nan);
Double boxedA = nan;
Double boxedB = nan;
println(boxedA == boxedB);
double? pz = 0.0;
double? nz = -0.0;
println(pz == nz);
var values = new double[] { 3.0, nan, -1.0 };
var count = 0;
foreach (var v in values) if (v > 0 || v <= 0) count++;
println(count);
println(Math.sqrt(-1));
println((int) nan);
println((long) Double.POSITIVE_INFINITY);
println((int) Double.NEGATIVE_INFINITY);
println(0.1f + 0.2f);
println(0.1 + 0.2 == 0.3);
println(0.1f + 0.2f == 0.3f);
print(0.1f);
println();
println(1e308 * 10);
println(Double.MIN_VALUE / 2);
println(nan == nan ? "eq" : "ne");
var label = if (nan > 0) "pos" else if (nan <= 0) "nonpos" else "unordered";
println(label);
