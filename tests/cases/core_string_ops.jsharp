// Concatenation rules, indexing/slicing strings, == vs === on strings.
var one = 1;
var two = 2;
println(one + two + "x" + one + two);
println("x" + (one + two));
println('a' + one + "b");
println("a" + 'b' + 'c');
String s = "hello";
println(s[0]);
println(s[^1]);
println(s[1..3]);
println(s[..2]);
println(s[3..]);
println(s[^3..]);
println(s.repeat(2));
println(s.compareTo("help") < 0);
println(String.valueOf(new char[] { 'o', 'k' }));
var u = new StringBuilder("hel").append("lo").toString();
println(u == s);
println(u === s);
println(u != s);
println(u !== s);
String? maybe = null;
println(maybe == null);
println(maybe == s);
println(s == maybe);
var parts = "a,b,,c,".split(",");
println(parts.length);
var concat = "";
for (int i = 0; i < 3; i++) concat += i;
println(concat);
concat += 'z';
println(concat);
concat += 1.5;
println(concat);
concat += true;
println(concat);
println("abc".indexOf('c'));
println("Mississippi".replace("ss", "SS"));
println("%s-%05.1f".formatted("v", 3.14159));
println("a" + null);
println(s + maybe);
Object obj = s;
println(obj + "!");
var chars = s.toCharArray();
java.util.Arrays.sort(chars);
println(new String(chars));
println(s.chars().filter(c => c == 'l').count());
