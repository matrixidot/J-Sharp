int fib(int n) => n < 2 ? n : fib(n - 1) + fib(n - 2);
for (int i = 0; i < 10; i++) {
    print(fib(i));
    print(" ");
}
println();
var i = 0;
while (true) {
    i++;
    if (i % 2 == 0) continue;
    if (i > 7) break;
    print(i);
}
println();
var j = 10;
do { j -= 3; } while (j > 0);
println(j);
outer: for (int a = 0; a < 3; a++) {
    for (int b = 0; b < 3; b++) {
        if (b == 2) continue outer;
        if (a == 2) break outer;
        print($"{a}{b} ");
    }
}
println();
var sum = 0;
foreach (var x in new int[] { 1, 2, 3, 4 }) sum += x;
println(sum);
var words = java.util.List.of("alpha", "beta", "gamma");
foreach (String w in words) {
    if (w.startsWith("b")) continue;
    println(w);
}
String grade(int score) {
    if (score >= 90) return "A";
    else if (score >= 80) return "B";
    else return "C";
}
println(grade(95) + grade(85) + grade(10));
var label = if (sum > 5) "big" else "small";
println(label);
int classify(int k) {
    switch (k) {
        case 0:
            return 0;
        case 1:
        case 2:
            return 1;
        default:
            return 2;
    }
}
println(classify(0) + classify(2) + classify(9));
