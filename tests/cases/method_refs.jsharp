import java.util.*;
import java.util.function.*;

class Greeter {
    private final String greeting;
    Greeter(String greeting) { this.greeting = greeting; }
    String greet(String name) => greeting + ", " + name;
    String greetAll(params String[] names) => greeting + " " + String.join("+", names);
}

private var calls = 0;
Greeter make() {
    calls++;
    return new Greeter("Hi");
}

// Bound reference: the receiver is evaluated once, when the reference is created.
Function<String, String> f = make()::greet;
println(f.apply("a"));
println(f.apply("b"));
println(calls);

// Bound reference to a varargs method goes through a synthetic lambda.
BiFunction<String, String, String> g = make()::greetAll;
println(g.apply("x", "y"));
println(g.apply("p", "q"));
println(calls);

// Null receivers fail at creation, not at the call.
Greeter? nobody = null;
try {
    Function<String, String> h = nobody!::greet;
    println("not reached");
} catch (NullPointerException e) {
    println("NPE at creation");
}

var sb = new StringBuilder();
Consumer<String> append = sb::append;
append.accept("one");
append.accept("two");
println(sb);

Function<String, Integer> parse = Integer::parseInt;
println(parse.apply("41") + 1);
BinaryOperator<Integer> max = Math::max;
println(max.apply(3, 9));
Function<String, String> trim = String::trim;
println("[" + trim.apply("  t  ") + "]");
Supplier<Greeter> ctor = () => new Greeter("Yo");
println(ctor.get().greet("z"));
Function<String, Greeter> ctorRef = Greeter::new;
println(ctorRef.apply("Hey").greet("w"));
// Members inherited from non-public JDK classes (AbstractStringBuilder).
var b2 = new StringBuilder("abc");
println(b2.length());
Function<StringBuilder, Integer> lenOf = StringBuilder::length;
println(lenOf.apply(b2));
Supplier<Integer> boundLen = b2::length;
println(boundLen.get());
CharSequence cs = b2;
println(cs.length() + cs.toString().length());
