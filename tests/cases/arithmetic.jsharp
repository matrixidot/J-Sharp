int b = 5;
println(a + b);
println(a - b);
println(a * b);
println(a / b);
println(a % b);
println(-a / b);
println(-a % b);
long big = 3_000_000_000L;
println(big * 2);
println(a / 2.0);
println(7.0 / 2);
println(1.0 / 0.0);
println(0.0 / 0.0);
println((int) 3.99);
println((int) -3.99);
println((long) 1e19);
println((byte) 200);
println((char) 65);
println((short) 70000);
println(Integer.MAX_VALUE + 1);
println(Long.MIN_VALUE - 1);
println(1 << 31);
println(1L << 40);
println(-16 >> 2);
println(-16 >>> 28);
println(0xFF & 0x0F);
println(0xF0 | 0x0F);
println(0xFF ^ 0x0F);
println(~5);
println(5 > 3 && 2 > 1);
println(5 > 3 || 1 / 0 > 0);
println(3.0f * 2);
char c = 'a';
c++;
println(c);
println(c + 1);
int x = 10;
x += 5;
x -= 3;
x *= 2;
x /= 4;
x %= 4;
x <<= 3;
x >>= 1;
x |= 1;
x &= 7;
x ^= 2;
println(x);
println(x++ + ++x);
println(x);
