import java.util.*;
import java.util.function.*;
import java.util.stream.*;

Predicate<String> isLong = s => s.length() > 4;
Predicate<String> startsA = s => s.startsWith("a");
var words = List.of("apple", "ant", "banana", "avocado", "kiwi", "apricot");
println(words.stream().filter(isLong.and(startsA)).toList());
println(words.stream().filter(isLong.or(startsA)).toList());
println(words.stream().filter(isLong.negate()).toList());
println(words.stream().filter(Predicate.not(startsA)).toList());
println(words.stream().filter(Predicate.isEqual("kiwi")).count());
BiFunction<int, int, int> add = (a, b) => a + b;
println(add.andThen(x => x * 10).apply(2, 3));
UnaryOperator<String> id = UnaryOperator.identity();
println(id.apply("same"));
BinaryOperator<String> shorter = BinaryOperator.minBy(Comparator.comparingInt(String::length));
println(shorter.apply("pear", "fig"));
BinaryOperator<int> bigger = BinaryOperator.maxBy(Comparator.naturalOrder());
println(bigger.apply(3, 8));
Supplier<List<String>> sup = () => new ArrayList<>(words.subList(0, 2));
println(sup.get());
BiConsumer<String, int> show = (k, v) => println(k + "=" + v);
show.andThen((k, v) => println("len " + (k.length() + v))).accept("x", 2);
BiPredicate<String, int> hasLen = (s, n) => s.length() == n;
println(hasLen.test("abc", 3) + " " + hasLen.negate().test("abc", 3));
ToDoubleFunction<String> half = s => s.length() / 2.0;
println(half.applyAsDouble("abcde"));
IntBinaryOperator pow = (b, e) => {
    var r = 1;
    for (var i = 0; i < e; i++) r *= b;
    return r;
};
println(pow.applyAsInt(2, 10));
LongSupplier big = () => 1L << 40;
println(big.getAsLong());
DoubleUnaryOperator sq = d => d * d;
println(sq.andThen(d => d + 1).applyAsDouble(1.5));
IntPredicate even = i => i % 2 == 0;
println(IntStream.rangeClosed(1, 10).filter(even.negate()).sum());
ObjIntConsumer<StringBuilder> rep = (sb, n) => sb.append("#".repeat(n));
var sb = new StringBuilder();
rep.accept(sb, 3);
println(sb);
Function<int, Predicate<int>> greaterThan = n => x => x > n;
println(List.of(1, 5, 10).stream().filter(greaterThan.apply(4)).toList());
