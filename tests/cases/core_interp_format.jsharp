// String interpolation with .NET-style and %-style format specifiers.
var n = 42;
var neg = -7;
double pi = Math.PI;
println($"{n}");
println($"[{n:D4}] [{n:X}] [{n:x}] [{n:X8}]");
println($"{255:X2} {16:x}");
println($"{neg:X}");
long bigL = 1L << 40;
println($"{bigL:X}");
byte bb = -1;
println($"{bb:X}");
println($"{pi:F0} {pi:F3} {pi:F}");
println($"{2.5:F0} {3.5:F0}");
println($"{1234567.891:N2} {1234567:N0}");
println($"{12345.6789:E2}");
println($"{0.5:P0} {0.125:P1}");
println($"{pi:G}");
println($"{n:%5d}|{n:%-5d}|");
println($"{pi:%08.3f}");
String? nothing = null;
println($"<{nothing}>");
println($"{n > 40} {(n > 40 ? "big" : "small")}");
println($"{{}} {{{n}}}");
println($"sum={n + neg} prod={n * neg}");
var items = java.util.List.of("a", "b");
println($"{items} size={items.size()} first={items.get(0)}");
println($"{"quoted"}");
println($"{$"[{n}]"}!");
var name = "x";
println($"{name}{name}{name}");
println($"{n:D}");
char ch = 'q';
println($"{ch}{ch + 1}{(char) (ch + 1)}");
float f = 1.1f;
println($"{f} {f:F3}");
println($"{n}{neg}" + $"{n + neg}");
var empty = $"";
println(empty.isEmpty());
