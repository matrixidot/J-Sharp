import java.util.*;
import java.util.stream.*;

var sentences = List.of("the quick brown fox", "jumps over the lazy dog", "the end");
var words = sentences.stream().flatMap(s => Arrays.stream(s.split(" "))).toList();
println(words.size());
println(words.stream().distinct().count());
println(words.stream().distinct().sorted().collect(Collectors.joining(" ")));
var freq = words.stream().collect(Collectors.groupingBy(w => w, () => new TreeMap<String, Long>(), Collectors.counting()));
println(freq);
List<List<int>> nested = List.of(List.of(1, 2), List.of(3), List.of(), List.of(4, 5, 6));
println(nested.stream().flatMap(List::stream).map(x => x * 10).toList());
println(nested.stream().mapToInt(List::size).max().getAsInt());
println(nested.stream().flatMapToInt(l => l.stream().mapToInt(x => x)).sum());
var pairs = IntStream.rangeClosed(1, 3).boxed().flatMap(a => IntStream.rangeClosed(a, 3).mapToObj(b => a + "" + b)).toList();
println(pairs);
var chars = Stream.of("ab", "cd").flatMap(s => s.chars().mapToObj(c => (char) c)).toList();
println(chars);
var letters = words.stream().flatMap(w => w.chars().mapToObj(c => String.valueOf((char) c))).distinct().count();
println(letters);
println(Stream.of(List.of("x"), List.of("y", "z")).flatMap(l => l.stream()).collect(Collectors.joining()));
