// Positional (record) patterns with constants, relational subpatterns, nesting, property patterns.
public record Point(int x, int y);
public record Line(Point from, Point to);
public record Box<T>(T value);

String where(Point p) => p switch {
    Point(0, 0) => "origin",
    Point(0, var y) => "on y-axis at " + y,
    Point(var x, 0) => "on x-axis at " + x,
    Point(var x, var y) when x == y => "diagonal " + x,
    Point(> 0, > 0) => "quadrant 1",
    _ => "elsewhere",
};

String lineKind(Line l) => l switch {
    Line(Point(var x1, var y1), Point(var x2, var y2)) when x1 == x2 && y1 == y2 => "degenerate",
    Line(Point(var x1, _), Point(var x2, _)) when x1 == x2 => "vertical",
    Line(Point(_, var y1), Point(_, var y2)) when y1 == y2 => "horizontal",
    Line { from: { x: 0, y: 0 } } => "from origin",
    Line { to.x: < 0 } => "ends left",
    _ => "sloped",
};

foreach (var p in new Point[] { new Point(0, 0), new Point(0, 4), new Point(3, 0), new Point(2, 2), new Point(1, 5), new Point(-1, 5) }) {
    println(where(p));
}
println(lineKind(new Line(new Point(1, 1), new Point(1, 1))));
println(lineKind(new Line(new Point(1, 1), new Point(1, 9))));
println(lineKind(new Line(new Point(1, 3), new Point(7, 3))));
println(lineKind(new Line(new Point(0, 0), new Point(7, 3))));
println(lineKind(new Line(new Point(2, 0), new Point(-7, 3))));
println(lineKind(new Line(new Point(2, 0), new Point(7, 3))));

Object obj = new Point(3, 4);
if (obj is Point(var a, var b)) println(a + b);
if (obj is Point { x: 3 } pt) println("x is three in " + pt);
var (px, py) = new Point(5, 6);
println(px * py);
var line = new Line(new Point(1, 2), new Point(3, 4));
var (start, end) = line;
println(start.x + end.y);
Box<String> bs = new Box<>("hi");
if (bs is Box<String>(var inner)) println(inner.length());
var described = bs switch {
    Box<String>(var s) when s.startsWith("h") => "h-box " + s,
    Box<String>(var s) => "box " + s,
};
println(described);
Object nested = new Box<Object>(new Point(9, 9));
var res = nested switch {
    Box<?>(Point(var x, var y)) => "boxed point " + (x + y),
    Box<?>(var other) => "boxed other",
    _ => "not a box",
};
println(res);
