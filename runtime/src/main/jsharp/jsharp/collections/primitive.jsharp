// Primitive sequences: pipelines over int/long/double that never box per element.
@file:ClassName("PrimitiveStages")
package jsharp.collections;

import java.util.*;
import java.util.function.*;

/** A lazy sequence of ints. Intermediate operations fuse; terminal operations run the pipeline. */
public abstract class IntSequence : Iterable<Integer> {
    /** Pushes elements into {@code sink} until it returns false; false if stopped early. */
    public abstract boolean forEachWhileInt(IntPredicate sink);

    /** Boxing iterator (used by foreach); prefer the terminal operations in hot code. */
    public open override Iterator<Integer> iterator() {
        val list = new ArrayList<Integer>();
        forEachWhileInt(x => list.add(x));
        return list.iterator();
    }

    public IntSequence where(IntPredicate predicate) {
        val self = this;
        return new IntStage(sink => self.forEachWhileInt(x => !predicate.test(x) || sink.test(x)));
    }

    public IntSequence select(IntUnaryOperator selector) {
        val self = this;
        return new IntStage(sink => self.forEachWhileInt(x => sink.test(selector.applyAsInt(x))));
    }

    public LongSequence selectLong(IntToLongFunction selector) {
        val self = this;
        return new LongStage(sink => self.forEachWhileInt(x => sink.test(selector.applyAsLong(x))));
    }

    public DoubleSequence selectDouble(IntToDoubleFunction selector) {
        val self = this;
        return new DoubleStage(sink => self.forEachWhileInt(x => sink.test(selector.applyAsDouble(x))));
    }

    public Sequence<R> selectObj<R>(IntFunction<R> selector) =>
        Sequences.deferredPush<R>(sink => forEachWhileInt(x => sink.test(selector.apply(x))));

    public Sequence<Integer> boxed() => selectObj<Integer>(x => x);

    public IntSequence take(int count) {
        val self = this;
        return new IntStage(sink => {
            if (count <= 0) return true;
            val c = new Counter();
            self.forEachWhileInt(x => {
                c.n++;
                if (!sink.test(x)) {
                    c.flag = true;
                    return false;
                }
                return c.n < count;
            });
            return !c.flag;
        });
    }

    public IntSequence skip(int count) {
        val self = this;
        return new IntStage(sink => {
            val c = new Counter();
            return self.forEachWhileInt(x => c.n++ < count || sink.test(x));
        });
    }

    public int sum() {
        val acc = new IntAcc();
        forEachWhileInt(x => { acc.value += x; return true; });
        return acc.value;
    }

    public long sumLong() {
        val acc = new LongAcc();
        forEachWhileInt(x => { acc.value += x; return true; });
        return acc.value;
    }

    public open int count() {
        val c = new Counter();
        forEachWhileInt(x => { c.n++; return true; });
        return c.n;
    }

    public int min() => aggregate((a, b) => Math.min(a, b));

    public int max() => aggregate((a, b) => Math.max(a, b));

    public double average() {
        val acc = new LongAcc();
        val c = new Counter();
        forEachWhileInt(x => { acc.value += x; c.n++; return true; });
        if (c.n == 0) throw new NoSuchElementException("sequence is empty");
        return (double) acc.value / c.n;
    }

    public int aggregate(int seed, IntBinaryOperator combine) {
        val acc = new IntAcc();
        acc.value = seed;
        forEachWhileInt(x => { acc.value = combine.applyAsInt(acc.value, x); return true; });
        return acc.value;
    }

    /** Combines all elements; an error if the sequence is empty. */
    public int aggregate(IntBinaryOperator combine) {
        val acc = new IntAcc();
        val c = new Counter();
        forEachWhileInt(x => {
            acc.value = c.flag ? combine.applyAsInt(acc.value, x) : x;
            c.flag = true;
            return true;
        });
        if (!c.flag) throw new NoSuchElementException("sequence is empty");
        return acc.value;
    }

    public boolean any() => !forEachWhileInt(x => false);

    public boolean any(IntPredicate predicate) => !forEachWhileInt(x => !predicate.test(x));

    public boolean all(IntPredicate predicate) => forEachWhileInt(x => predicate.test(x));

    public int first() {
        val acc = new IntAcc();
        if (forEachWhileInt(x => { acc.value = x; return false; })) {
            throw new NoSuchElementException("sequence is empty");
        }
        return acc.value;
    }

    public int[] toArray() {
        val buf = new IntBuffer();
        forEachWhileInt(x => { buf.add(x); return true; });
        return buf.toArray();
    }

    public ArrayList<Integer> toList() {
        val out = new ArrayList<Integer>();
        forEachWhileInt(x => out.add(x));
        return out;
    }

    public String joinToString(String separator = ", ") => boxed().joinToString(separator);

    public override String toString() => boxed().toString();
}

/** A lazy sequence of longs. */
public abstract class LongSequence : Iterable<Long> {
    public abstract boolean forEachWhileLong(LongPredicate sink);

    public open override Iterator<Long> iterator() {
        val list = new ArrayList<Long>();
        forEachWhileLong(x => list.add(x));
        return list.iterator();
    }

    public LongSequence where(LongPredicate predicate) {
        val self = this;
        return new LongStage(sink => self.forEachWhileLong(x => !predicate.test(x) || sink.test(x)));
    }

    public LongSequence select(LongUnaryOperator selector) {
        val self = this;
        return new LongStage(sink => self.forEachWhileLong(x => sink.test(selector.applyAsLong(x))));
    }

    public Sequence<R> selectObj<R>(LongFunction<R> selector) =>
        Sequences.deferredPush<R>(sink => forEachWhileLong(x => sink.test(selector.apply(x))));

    public Sequence<Long> boxed() => selectObj<Long>(x => x);

    public long sum() {
        val acc = new LongAcc();
        forEachWhileLong(x => { acc.value += x; return true; });
        return acc.value;
    }

    public int count() {
        val c = new Counter();
        forEachWhileLong(x => { c.n++; return true; });
        return c.n;
    }

    public long min() => aggregate((a, b) => Math.min(a, b));

    public long max() => aggregate((a, b) => Math.max(a, b));

    public long aggregate(LongBinaryOperator combine) {
        val acc = new LongAcc();
        val c = new Counter();
        forEachWhileLong(x => {
            acc.value = c.flag ? combine.applyAsLong(acc.value, x) : x;
            c.flag = true;
            return true;
        });
        if (!c.flag) throw new NoSuchElementException("sequence is empty");
        return acc.value;
    }

    public boolean any(LongPredicate predicate) => !forEachWhileLong(x => !predicate.test(x));

    public ArrayList<Long> toList() {
        val out = new ArrayList<Long>();
        forEachWhileLong(x => out.add(x));
        return out;
    }

    public override String toString() => boxed().toString();
}

/** A lazy sequence of doubles. */
public abstract class DoubleSequence : Iterable<Double> {
    public abstract boolean forEachWhileDouble(DoublePredicate sink);

    public open override Iterator<Double> iterator() {
        val list = new ArrayList<Double>();
        forEachWhileDouble(x => list.add(x));
        return list.iterator();
    }

    public DoubleSequence where(DoublePredicate predicate) {
        val self = this;
        return new DoubleStage(sink => self.forEachWhileDouble(x => !predicate.test(x) || sink.test(x)));
    }

    public DoubleSequence select(DoubleUnaryOperator selector) {
        val self = this;
        return new DoubleStage(sink => self.forEachWhileDouble(x => sink.test(selector.applyAsDouble(x))));
    }

    public Sequence<R> selectObj<R>(DoubleFunction<R> selector) =>
        Sequences.deferredPush<R>(sink => forEachWhileDouble(x => sink.test(selector.apply(x))));

    public Sequence<Double> boxed() => selectObj<Double>(x => x);

    public double sum() {
        val acc = new DoubleAcc();
        forEachWhileDouble(x => { acc.value += x; return true; });
        return acc.value;
    }

    public int count() {
        val c = new Counter();
        forEachWhileDouble(x => { c.n++; return true; });
        return c.n;
    }

    public double average() {
        val acc = new DoubleAcc();
        val c = new Counter();
        forEachWhileDouble(x => { acc.value += x; c.n++; return true; });
        if (c.n == 0) throw new NoSuchElementException("sequence is empty");
        return acc.value / c.n;
    }

    public double min() => aggregate((a, b) => Math.min(a, b));

    public double max() => aggregate((a, b) => Math.max(a, b));

    public double aggregate(DoubleBinaryOperator combine) {
        val acc = new DoubleAcc();
        val c = new Counter();
        forEachWhileDouble(x => {
            acc.value = c.flag ? combine.applyAsDouble(acc.value, x) : x;
            c.flag = true;
            return true;
        });
        if (!c.flag) throw new NoSuchElementException("sequence is empty");
        return acc.value;
    }

    public ArrayList<Double> toList() {
        val out = new ArrayList<Double>();
        forEachWhileDouble(x => out.add(x));
        return out;
    }

    public override String toString() => boxed().toString();
}

// -------------------------------------------------------------------- implementation

/** The traversal of a primitive stage, as a function of its sink. */
interface IntTraversal { boolean run(IntPredicate sink); }
interface LongTraversal { boolean run(LongPredicate sink); }
interface DoubleTraversal { boolean run(DoublePredicate sink); }

final class IntStage : IntSequence {
    private final IntTraversal traversal;
    IntStage(IntTraversal traversal) { this.traversal = traversal; }
    public override boolean forEachWhileInt(IntPredicate sink) => traversal.run(sink);
}

final class LongStage : LongSequence {
    private final LongTraversal traversal;
    LongStage(LongTraversal traversal) { this.traversal = traversal; }
    public override boolean forEachWhileLong(LongPredicate sink) => traversal.run(sink);
}

final class DoubleStage : DoubleSequence {
    private final DoubleTraversal traversal;
    DoubleStage(DoubleTraversal traversal) { this.traversal = traversal; }
    public override boolean forEachWhileDouble(DoublePredicate sink) => traversal.run(sink);
}

/** Integers in [start, end) with a step. */
final class IntRange : IntSequence {
    private final int start;
    private final int end;
    private final int step;

    IntRange(int start, int end, int step) {
        this.start = start;
        this.end = end;
        this.step = step;
    }

    public override boolean forEachWhileInt(IntPredicate sink) {
        if (step > 0) {
            for (int i = start; i < end; i += step) {
                if (!sink.test(i)) return false;
            }
        } else {
            for (int i = start; i > end; i += step) {
                if (!sink.test(i)) return false;
            }
        }
        return true;
    }

    public override Iterator<Integer> iterator() => new IntRangeIterator(start, end, step);

    public override int count() {
        if (step > 0) return start >= end ? 0 : (int) (((long) end - start + step - 1) / step);
        return start <= end ? 0 : (int) (((long) start - end - step - 1) / -step);
    }
}

final class IntRangeIterator : Iterator<Integer> {
    private int next;
    private final int end;
    private final int step;

    IntRangeIterator(int start, int end, int step) {
        this.next = start;
        this.end = end;
        this.step = step;
    }

    public override boolean hasNext() => step > 0 ? next < end : next > end;

    public override Integer next() {
        if (!hasNext()) throw new NoSuchElementException();
        val v = next;
        next += step;
        return v;
    }
}

final class IntArraySource : IntSequence {
    private final int[] array;
    IntArraySource(int[] array) { this.array = array; }

    public override boolean forEachWhileInt(IntPredicate sink) {
        foreach (var x in array) {
            if (!sink.test(x)) return false;
        }
        return true;
    }

    public override int count() => array.length;
}

final class LongArraySource : LongSequence {
    private final long[] array;
    LongArraySource(long[] array) { this.array = array; }

    public override boolean forEachWhileLong(LongPredicate sink) {
        foreach (var x in array) {
            if (!sink.test(x)) return false;
        }
        return true;
    }
}

final class DoubleArraySource : DoubleSequence {
    private final double[] array;
    DoubleArraySource(double[] array) { this.array = array; }

    public override boolean forEachWhileDouble(DoublePredicate sink) {
        foreach (var x in array) {
            if (!sink.test(x)) return false;
        }
        return true;
    }
}

final class IntAcc { int value; }
final class LongAcc { long value; }
final class DoubleAcc { double value; }

/** A growable int array. */
final class IntBuffer {
    private int[] data = new int[16];
    private int size;

    void add(int x) {
        if (size == data.length) data = Arrays.copyOf(data, size * 2);
        data[size++] = x;
    }

    int[] toArray() => Arrays.copyOf(data, size);
}
