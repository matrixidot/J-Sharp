{
  "name": "jsharp",
  "displayName": "J#",
  "description": "J# language support: highlighting, errors as you type, hover, go to definition, references, rename, parameter hints, completion, outline, and Run.",
  "version": "0.1.0",
  "publisher": "matrixidot",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/matrixidot/J-Sharp" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:jsharp", "workspaceContains:**/*.jsharp"],
  "contributes": {
    "languages": [
      {
        "id": "jsharp",
        "aliases": ["J#", "jsharp"],
        "extensions": [".jsharp"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "jsharp", "scopeName": "source.jsharp", "path": "./syntaxes/jsharp.tmLanguage.json" }
    ],
    "configuration": {
      "title": "J#",
      "properties": {
        "jsharp.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to a `jsharp` launcher to use instead of the one bundled with the extension (for example <repo>/cli/build/install/jsharp/bin/jsharp)."
        },
        "jsharp.classPath": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra jars and class directories, for analysis and Run (passed as -cp)."
        }
      }
    },
    "commands": [
      { "command": "jsharp.run", "title": "J#: Run Program", "icon": "$(play)" },
      { "command": "jsharp.restartServer", "title": "J#: Restart Language Server" },
      { "command": "jsharp.newProject", "title": "J#: New Project..." }
    ],
    "viewsWelcome": [
      {
        "view": "explorer",
        "contents": "Start writing J#:\n[New J# Project](command:jsharp.newProject)",
        "when": "workbenchState == empty"
      }
    ],
    "menus": {
      "editor/title/run": [
        { "command": "jsharp.run", "when": "resourceLangId == jsharp", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "jsharp.run", "when": "editorLangId == jsharp" }
      ]
    },
    "keybindings": [
      { "command": "jsharp.run", "key": "ctrl+f5", "mac": "cmd+f5", "when": "editorLangId == jsharp" }
    ]
  }
}
